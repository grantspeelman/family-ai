{
  "name": "family-ai",
  "dockerComposeFile": [
    "docker-compose.yml",
    "agent-state.compose.json"
  ],
  "service": "app",
  "overrideCommand": false,
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.terminalAuthentication": false,
        "github.gitAuthentication": false
      }
    }
  },
  "postStartCommand": "/opt/family-ai-controls/postStartCommand.sh",
  "initializeCommand": [
    "bash",
    ".devcontainer/check-vscode-host.sh"
  ]
}
