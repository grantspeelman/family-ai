# Names the dev container reads from the host environment. No values here.
# Compose reads no .env file: export these in your shell before running
# .devcontainer/start.sh.

# GitHub token for `gh` inside the container. Normally not set by hand:
# start.sh takes it from the host's credential store (see
# .devcontainer/README.md, "GitHub token"). Setting GH_TOKEN or GITHUB_TOKEN
# yourself overrides the store.

# Optional: UID/GID for the image's `vscode` user. start.sh sets these from
# `id -u` / `id -g`; override only if you build by hand.
USER_UID=
USER_GID=
