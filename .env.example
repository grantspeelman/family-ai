# Optional overrides only; no values here.
# Nothing token-related lives in the repo or in an .env file: the GitHub token
# is read from ~/.config/family-ai/gh.env (see .devcontainer/README.md,
# "GitHub token"). start.sh makes compose read no .env file.

# Optional: UID/GID for the image's `vscode` user. start.sh sets these from
# `id -u` / `id -g`; override only if you build by hand.
USER_UID=
USER_GID=
