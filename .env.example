# Host environment the dev container reads. Copy to .env if you want, or export
# these in your shell before running .devcontainer/start.sh. Values are never
# committed; this file lists names only.

# GitHub token for `gh` inside the container (PRs, issues). Use a fine-grained
# token scoped to this repository. Either name works; one is enough.
GH_TOKEN=
GITHUB_TOKEN=

# Optional: UID/GID the image's `vscode` user is built with. start.sh sets
# these from `id -u` / `id -g`; override only if you build by hand.
USER_UID=
USER_GID=

# Set by start.sh itself, not by you: HOST_SSH_AUTH_SOCK (forwarded ssh-agent).
