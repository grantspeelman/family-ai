# Names the dev container reads from the host environment. No values here.
# Either export them in your shell before running .devcontainer/start.sh, or
# copy this file to .devcontainer/.env (gitignored), which compose reads.

# Optional: UID/GID for the image's `vscode` user. start.sh sets these from
# `id -u` / `id -g`; override only if you build by hand.
USER_UID=
USER_GID=
